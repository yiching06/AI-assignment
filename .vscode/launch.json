{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Sentiment UI",
      "type": "python",
      "request": "launch",
      "module": "ai_assignment.interfaces.desktop_app",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Sentiment Console",
      "type": "python",
      "request": "launch",
      "module": "ai_assignment.core.sentiment_analyzer",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Streamlit App",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}\\ai_assignment\\interfaces\\streamlit_app.py"
      ],
      "console": "integratedTerminal"
    }
  ]
}
